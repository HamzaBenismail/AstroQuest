# Dependencies — restore with `npm install` (package-lock.json is committed)
node_modules/

# Build output — regenerate with `npm run build`
dist/

# Local environment and secrets
.env
.env.*
!.env.example

# Vite / tooling caches
.vite/
*.tsbuildinfo

# Test and coverage output
coverage/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor and OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code per-user settings (shared config such as launch.json stays tracked)
.claude/settings.local.json
